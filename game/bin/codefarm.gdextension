[configuration]

entry_symbol = "codefarm_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libcodefarm.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libcodefarm.linux.template_debug.x86_64.so"
linux.template_debug.x86_64 = "res://bin/libcodefarm.linux.template_debug.x86_64.so"
linux.template_release.x86_64 = "res://bin/libcodefarm.linux.template_debug.x86_64.so"

windows.debug.x86_64 = "res://bin/codefarm.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/codefarm.windows.template_debug.x86_64.dll"
windows.template_debug.x86_64 = "res://bin/codefarm.windows.template_debug.x86_64.dll"
windows.template_release.x86_64 = "res://bin/codefarm.windows.template_debug.x86_64.dll"

